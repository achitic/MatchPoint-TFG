# .env — Variables de entorno para MatchPoint
# Copia este archivo a .env y ajusta según tu entorno
# Nunca subas el archivo .env real al repositorio

# ── Backend ─────────────────────────────────────────────
# Orígenes CORS permitidos (separados por comas)
# Por defecto: puertos de desarrollo de Vite y CRA
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Guardrails de probabilidad extrema (elite vs elite)
STACKING_TEMPERATURE=3.0
ELITE_TOP_RANK_MAX=10
ELITE_RANK_GAP_MAX=5
ELITE_ELO_GAP_MAX=120
ELITE_CLAMP_LOW=0.30
ELITE_CLAMP_HIGH=0.70

# Ciclo de vida del tracker en vivo (estado en memoria)
INPLAY_STATE_TTL_SECONDS=21600
INPLAY_MAX_STATES=1000

# ── Frontend (Vite) ──────────────────────────────────────
# URL base de la API del backend
VITE_API_BASE=http://localhost:8000
